<CodeTemplates>
  <CodeTemplate>
    <Description>Read from file</Description>
    <Text>   Dim fileHandle As Integer
   Dim textLine As String
   
   fileHandle = FreeFile
   
   Open "$U[File Name]" For Input As #fileHandle
   Do While Not EOF(fileHandle)
      Line Input #fileHandle, textLine
      Debug.Print textLine
   Loop
   Close #fileHandle</Text>
    <Author />
    <Comment />
    <ExpansionKeyword />
    <CommandName />
    <Category>VB/VBA\File input &amp; output</Category>
    <Language>8</Language>
  </CodeTemplate>
  <CodeTemplate>
    <Description>Write to file</Description>
    <Text>   Dim fileHandle As Integer
   
   fileHandle = FreeFile
   
   Open "$U[File Name]" For Output As #fileHandle
   Print #fileHandle, "$U[Line Text]"
   $P[I]
   Close #fileHandle</Text>
    <Author />
    <Comment>Do not forget to add error handling</Comment>
    <ExpansionKeyword />
    <CommandName />
    <Category>VB/VBA\File input &amp; output</Category>
    <Language>8</Language>
  </CodeTemplate>
