<span class=3D"cmt">'------------------------------------------------------=
-------------------------
'                        WordDocumentSaveClose
'--------------------------------------------------------------------------=
-----</span>
<span class=3D"kw">Public Function</span> WordDocumentSaveClose(oDoc <span =
class=3D"kw">As Object</span> _=20
   ,psFilename <span class=3D"kw">As String</span> _=20
   ,<span class=3D"kw">Optional</span> psFolder <span class=3D"kw">As Strin=
g</span> =3D  "" _=20
   ,<span class=3D"kw">Optional</span> psFormatDateTime <span class=3D"kw">=
As String</span> =3D  "yymmdd_hhnnss" _=20
   ,<span class=3D"kw">Optional</span> psReturnPath <span class=3D"kw">As S=
tring</span> _=20
   ) <span class=3D"kw">As String</span>=20
<span class=3D"cmt">'220420 strive4peace
'save Word document as file on desktop or in folder
'Return Path\Filename.Ext
'Return Path in psReturnPath
'if psFolder specified, path is that folder on the desktop
'     future: detect if path is absolute and use that instead
'if no file extension specified, default will be added
'oDoc is the document object</span>

<span class=3D"cmt">' EXAMPLE:
'  CALL WordDocumentSaveClose(oDoc, "Word_Styles_s4p_", "strive4peace",,sPa=
th)</span>

   <span class=3D"cmt">'PARAMETERS
   '  oDoc is the Word document object
   '  psFilename is what to call the file, with or without an extension
   '  psFolder is a folder name on the desktop
   '  psFormatDateTime is the date/time format to add, "" to skip
   '  psReturnPath is the Path</span>

   <span class=3D"cmt">'RETURN
   '  Path\Filename.Ext</span>
  =20
   <span class=3D"cmt">'CALLS
   '  GetDesktopPath
   '  MakeAPath</span>

   <span class=3D"kw">On Error GoTo</span> Proc_Err=20
  =20
   <span class=3D"kw">Dim</span> sPath <span class=3D"kw">As String</span> =
_=20
      ,sPathFile <span class=3D"kw">As String</span>=20
     =20
   <span class=3D"cmt">'get desktop path ending with \</span>
   sPath =3D GetDesktopPath(<span class=3D"kw">True</span>)=20
  =20
   <span class=3D"kw">If</span> psFolder &lt;&gt;  "" <span class=3D"kw">Th=
en</span>=20
      <span class=3D"cmt">'make or use a folder on the desktop</span>
      sPath =3D sPath &amp; psFolder &amp;  "\"
      <span class=3D"kw">If</span> Dir(sPath,vbDirectory) =3D vbNullString =
<span class=3D"kw">Then</span>=20
         <span class=3D"kw">MkDir</span> sPath=20
         <span class=3D"kw">DoEvents</span>=20
      <span class=3D"kw">End If</span>=20

   <span class=3D"kw">End If</span>=20
  =20
   sPathFile =3D sPath &amp; psFilename _=20
      &amp; IIf(psFormatDateTime &lt;&gt;  "", "_" &amp; Format(Now,psForma=
tDateTime), "")=20

   oDoc.SaveAs sPathFile=20
  =20
   <span class=3D"cmt">'return path in a parameter</span>
   psReturnPath =3D sPath=20
  =20
   <span class=3D"cmt">'return full path and filename with extension</span>
   WordDocumentSaveClose =3D oDoc.FullName=20
  =20
   <span class=3D"cmt">'close document without saving</span>
   oDoc.Close SaveChanges:=3DFalse=20
  =20
Proc_Exit:=20
   <span class=3D"kw">On Error Resume Next</span>=20
   <span class=3D"kw">Exit Function</span>=20
 =20
Proc_Err:=20
   MsgBox Err.Description _=20
       ,, "ERROR " &amp; Err.Number _=20
        &amp;  "   WordDocumentSaveClose"

   <span class=3D"kw">Resume</span> Proc_Exit=20
   <span class=3D"kw">Resume</span>=20
<span class=3D"kw">End Function</span>=20

<span class=3D"cmt">'------------------------------------------------------=
-------------------------
