'--------------------------------------------------------------------------=
-----</span>
<span class=3D"kw">Function</span> GetDesktopPath( _=20
   <span class=3D"kw">Optional</span> pbAddTrailBackslash <span class=3D"kw=
">As Boolean</span> =3D <span class=3D"kw">False</span> _=20
   ) <span class=3D"kw">As String</span>=20
<span class=3D"cmt">'strive4peace</span>
   <span class=3D"kw">With</span> CreateObject( "WScript.Shell")=20
      GetDesktopPath =3D .SpecialFolders( "Desktop") _=20
         &amp; IIf(pbAddTrailBackslash, "\", "")=20
   <span class=3D"kw">End With</span>=20
<span class=3D"kw">End Function</span>=20

<span class=3D"cmt">'------------------------------------------------------=
-------------------------
'                       Styles_FontList_s4p
'--------------------------------------------------------------------------=
-----</span>
<span class=3D"kw">Public Sub</span> Styles_FontList_s4p(poDoc <span class=
=3D"kw">As</span> Document)=20
<span class=3D"cmt">'260302,7</span>
   <span class=3D"kw">With</span> poDoc=20
      <span class=3D"cmt">'redefine</span>
      <span class=3D"kw">With</span> .Styles( "Normal")=20
         <span class=3D"cmt">'don't update global Normal template</span>
         .AutomaticallyUpdate =3D <span class=3D"kw">False</span>=20
         <span class=3D"kw">With</span> .Font=20
            .Size =3D 10=20
            .Color =3D 0  <span class=3D"cmt">'wdColorBlack</span>
         <span class=3D"kw">End With</span>=20
         <span class=3D"kw">With</span> .ParagraphFormat=20
            .SpaceBefore =3D 0=20
            .SpaceAfter =3D 0=20
             .LineSpacingRule =3D wdLineSpaceSingle  <span class=3D"cmt">'0=
</span>
         <span class=3D"kw">End With</span>  <span class=3D"cmt">'Paragraph=
Format</span>
      <span class=3D"kw">End With</span>  <span class=3D"cmt">'aExampleText=
</span>
     =20
      <span class=3D"kw">With</span> .Styles( "Heading 1")=20
         .AutomaticallyUpdate =3D <span class=3D"kw">False</span>=20
         <span class=3D"kw">With</span> .ParagraphFormat=20
            .SpaceBefore =3D 0=20
         <span class=3D"kw">End With</span>=20
      <span class=3D"kw">End With</span>=20
      <span class=3D"kw">With</span> .Styles( "Heading 3")=20
         .AutomaticallyUpdate =3D <span class=3D"kw">False</span>=20
         <span class=3D"kw">With</span> .Font=20
            .Size =3D 10=20
         <span class=3D"kw">End With</span>=20
         <span class=3D"kw">With</span> .ParagraphFormat=20
            .LeftIndent =3D 0=20
            .RightIndent =3D 0=20
            .SpaceBefore =3D 0=20
            .SpaceAfter =3D 0=20
            .LineSpacingRule =3D 0  <span class=3D"cmt">'wdLineSpaceSingle<=
/span>
            .Alignment =3D 0  <span class=3D"cmt">'wdAlignParagraphLeft</sp=
an>
            .KeepWithNext =3D <span class=3D"kw">False</span>  <span class=
=3D"cmt">'since in a table</span>
            .KeepTogether =3D <span class=3D"kw">False</span>=20
         <span class=3D"kw">End With</span>  <span class=3D"cmt">'Paragraph=
Format</span>
      <span class=3D"kw">End With</span>  <span class=3D"cmt">'Heading 3</s=
pan>

   <span class=3D"kw">End With</span>=20
<span class=3D"kw">End Sub</span>=20

<span class=3D"cmt">'------------------------------------------------------=
-------------------------
'                       WriteHeader_s4p_FontList
'--------------------------------------------------------------------------=
-----</span>

<span class=3D"kw">Private Sub</span> WriteHeader_s4p_FontList( _=20
   oDoc <span class=3D"kw">As</span> Document _=20
   ,<span class=3D"kw">Optional</span> psHeadDescription <span class=3D"kw"=
>As String</span> _=20
   )=20
<span class=3D"cmt">'220530 strive4peace ... 260301...3
'Collapse tip from Doug Robbins so range doesn't have to be selected</span>

   <span class=3D"kw">Dim</span> sgTabStop <span class=3D"kw">As Single</sp=
an> _=20
      ,sTemp <span class=3D"kw">As String</span>=20
     =20
   <span class=3D"kw">With</span> oDoc.PageSetup=20
      sgTabStop =3D .PageWidth - .LeftMargin - .RightMargin=20
   <span class=3D"kw">End With</span>=20
  =20
   <span class=3D"kw">Dim</span> oRange <span class=3D"kw">As Object</span>=
=20
   <span class=3D"cmt">'1=3D wdHeaderFooterPrimary</span>
   <span class=3D"kw">Set</span> oRange =3D oDoc.Sections(1).Headers(1).Ran=
ge=20
   <span class=3D"kw">With</span> oDoc=20
      <span class=3D"cmt">'----------- styleref to heading 1, 2
      'reference to Heading 1
      ' -1=3DwdFieldEmpty, False=3D Don't PreserveFormatting
      'reference oDoc</span>
      .Fields.Add oRange,-1 _=20
         , "STYLEREF " &amp; <span class=3D"kw">Chr</span>(34) &amp;  "Head=
ing 1" &amp; <span class=3D"kw">Chr</span>(34),<span class=3D"kw">False</sp=
an>=20
      <span class=3D"kw">Set</span> oRange =3D .Sections(1).Headers(1).Rang=
e=20
      <span class=3D"cmt">'position cursor after field just added</span>
      oRange.Collapse 0  <span class=3D"cmt">'wdCollapseEnd</span>
     =20
      <span class=3D"cmt">' add comma space</span>
      oRange.InsertAfter  ", "
      <span class=3D"cmt">'collapse to end</span>
      oRange.Collapse Direction:=3D0  <span class=3D"cmt">'wdCollapseEnd</s=
pan>
     =20
      <span class=3D"cmt">'reference to Heading 3
      ' -1=3DwdFieldEmpty</span>
      .Fields.Add oRange,-1 _=20
            , "STYLEREF " &amp; <span class=3D"kw">Chr</span>(34) &amp;  "H=
eading 3" &amp; <span class=3D"kw">Chr</span>(34),<span class=3D"kw">False<=
/span>=20
      <span class=3D"kw">Set</span> oRange =3D .Sections(1).Headers(1).Rang=
e=20
      oRange.Collapse Direction:=3D0=20
      <span class=3D"cmt">'-----------</span>
     =20
      <span class=3D"kw">If</span> psHeadDescription &lt;&gt;  "" <span cla=
ss=3D"kw">Then</span>=20
         sTemp =3D psHeadDescription &amp;  ", "
      <span class=3D"kw">Else</span>=20
         sTemp =3D  ""
      <span class=3D"kw">End If</span>=20
      sTemp =3D sTemp &amp;  "strive4peace, page "
     =20
      <span class=3D"cmt">'add TABs and text to align on right</span>
      oRange.InsertAfter vbTab &amp; sTemp=20

      oRange.Collapse Direction:=3D0=20
     =20
      <span class=3D"cmt">'reference to Page number</span>
      .Fields.Add oRange,-1, "Page ",<span class=3D"kw">False</span>=20
      <span class=3D"kw">Set</span> oRange =3D .Sections(1).Headers(1).Rang=
e=20
      <span class=3D"cmt">'collapse to end</span>
      oRange.Collapse Direction:=3D0=20
     =20
      <span class=3D"cmt">'insert /</span>
      oRange.InsertAfter  "/"
      oRange.Collapse 0=20
     =20
      <span class=3D"cmt">'reference to total pages
      'duct tape, had to use oRange.Parent to get in right place</span>
      oRange.Parent.Fields.Add oRange,-1, "NumPages",<span class=3D"kw">Fal=
se</span>=20
      <span class=3D"kw">Set</span> oRange =3D .Sections(1).Headers(1).Rang=
e=20
      oRange.Collapse 0=20
     =20
       <span class=3D"cmt">'update fields</span>
      .Sections(1).Headers(1).Range.Fields.Update=20
    =20
      <span class=3D"cmt">'border line below paragraph</span>
      <span class=3D"kw">With</span> oRange=20
         <span class=3D"kw">With</span> .ParagraphFormat=20
            <span class=3D"cmt">'6 point space after paragraph</span>
            .SpaceAfter =3D 6=20
            <span class=3D"cmt">'clear default tab stops</span>
            .TabStops.ClearAll=20
            <span class=3D"cmt">'right tab stop at 6.5 inches
            'wdAlignTabRight=3D2
            'wdTabLeaderSpaces=3D0</span>
            .TabStops.Add Position:=3DsgTabStop _=20
               ,Alignment:=3D2 _=20
               ,Leader:=3D0=20
         <span class=3D"kw">End With</span>  <span class=3D"cmt">'Paragraph=
Format</span>
         <span class=3D"kw">With</span> .Borders(-3)  <span class=3D"cmt">'=
wdBorderBottom =3D-3</span>
            .LineStyle =3D 1   <span class=3D"cmt">'wdLineStyleSingle=3D1</=
span>
            .LineWidth =3D 8  <span class=3D"cmt">'wdLineWidth100pt=3D8</sp=
an>
            .Color =3D RGB(75,75,75)  <span class=3D"cmt">'dark gray</span>
         <span class=3D"kw">End With</span>  <span class=3D"cmt">'Borders</=
span>
      <span class=3D"kw">End With</span>=20
      .Range.Collapse 1  <span class=3D"cmt">'goto beginning of document</s=
pan>
   <span class=3D"kw">End With</span>=20
<span class=3D"kw">End Sub</span>=20

<span class=3D"cmt">'------------------------------------------------------=
-------------------------
'                       InputCharGetAsc
'--------------------------------------------------------------------------=
-----</span>
<span class=3D"kw">Sub</span> InputCharGetAsc()=20
<span class=3D"cmt">'260309 s4p
'NOT USED -- in here for interest
'enter a character on the keyboard, get the Asc() result for it
'if &gt;1 characters entered, only first will be considered</span>

   <span class=3D"cmt">'CLICK HERE
   ' press F5 to Run!</span>
  =20
   <span class=3D"kw">Dim</span> sInput <span class=3D"kw">As String</span>=
=20
   <span class=3D"kw">Dim</span> sChar <span class=3D"kw">As String</span>=
=20
   <span class=3D"kw">Dim</span> sMsg <span class=3D"kw">As String</span>=
=20
  =20
   sMsg =3D  "Type a character and then press ENTER " _=20
      &amp;  " or click OK" _=20
      &amp;  " to get the Asc() result"
  =20
   sInput =3D InputBox(sMsg, "Get Asc() for character")=20
     =20
   <span class=3D"cmt">'Cancel</span>
   <span class=3D"kw">If</span> sInput =3D  "" <span class=3D"kw">Then Exit=
 Sub</span>=20
  =20
   <span class=3D"cmt">'-------------</span>
   sChar =3D Left(sInput,1)=20
  =20
   sMsg =3D  "Asc() for " &amp; sChar _=20
      &amp; vbCrLf &amp;  " is " &amp; Asc(sChar)=20
     =20
   MsgBox sMsg,, "InputCharGetAsc"
  =20
<span class=3D"kw">End Sub</span>=20
<span class=3D"cmt">'*************** Code End *****************************=
**************************</span></pre>




