    <span class=3D"kw">Private Declare PtrSafe Function</span> MessageBoxW =
_=20
    <span class=3D"kw">Lib</span>  "user32" ( _=20
    <span class=3D"kw">ByVal</span> hWnd <span class=3D"kw">As LongPtr</spa=
n> _=20
    ,<span class=3D"kw">ByVal</span> lpText <span class=3D"kw">As LongPtr</=
span> _=20
    ,<span class=3D"kw">ByVal</span> lpCaption <span class=3D"kw">As LongPt=
r</span> _=20
    ,<span class=3D"kw">ByVal</span> uType <span class=3D"kw">As Long</span=
>) <span class=3D"kw">As Long</span>=20
#Else=20
