      <span class=3D"kw">Next</span> i=20
      <span class=3D"cmt">'Shading for header row</span>
      .Shading.BackgroundPatternColor =3D RGB(232,232,232)=20
   <span class=3D"kw">End With</span>  <span class=3D"cmt">'first row
   'Not used:
'      'wdLineStyleNone =3D 0
'      .Borders(-7).LineStyle =3D 0 'wdBorderDiagonalDown =3D-7
'      .Borders(-8).LineStyle =3D 0 'wdBorderDiagonalUp =3D-8</span>
<span class=3D"kw">End Sub</span>=20

