<span class=3D"kw">Public Sub</span> Word_TableBorders_s4p(oTable <span cla=
ss=3D"kw">As</span> Table)   <span class=3D"cmt">'Word.Table
's4p 170811</span>
   <span class=3D"kw">Dim</span> i <span class=3D"kw">As Integer</span>=20
   <span class=3D"kw">With</span> oTable=20
      <span class=3D"kw">For</span> i =3D 1 <span class=3D"kw">To</span> 6=
=20
         <span class=3D"cmt">'wdBorderTop =3D-1
         'wdBorderLeft =3D -2
         'wdBorderBottom =3D-3
         'wdBorderRight=3D -4
         'wdBorderHorizontal =3D -5
         'wdBorderVertical =3D -6</span>
         <span class=3D"kw">With</span> .Borders(-i)=20
            .LineStyle =3D 1   <span class=3D"cmt">'wdLineStyleSingle=3D1</=
span>
            .LineWidth =3D 8  <span class=3D"cmt">'wdLineWidth100pt=3D8. wd=
LineWidth150pt=3D12</span>
            .Color =3D RGB(200,200,200)  <span class=3D"cmt">'medium-light =
gray</span>
         <span class=3D"kw">End With</span>=20
      <span class=3D"kw">Next</span> i=20
   <span class=3D"kw">End With</span>=20
   <span class=3D"cmt">'change borders to black for header row</span>
   <span class=3D"kw">With</span> oTable.Rows(1)=20
      <span class=3D"kw">For</span> i =3D 1 <span class=3D"kw">To</span> 4=
=20
         <span class=3D"kw">With</span> .Borders(-i)=20
            .Color =3D 0       <span class=3D"cmt">'wdColorBlack =3D 0</spa=
n>
