' LICENSE  :
'   You may freely use and share this code, but not sell it.
'   Keep attribution. Mark your changes. Use at your own risk.
'--------------------------------------------------------------------------=
-----
'--------------------------------------------------------------------------=
-----
'                       aFONTLIST_s4p
'--------------------------------------------------------------------------=
-----</span>
<span class=3D"kw">Public Sub</span> aFONTLIST_s4p()=20
<span class=3D"cmt">'sets up parameters for FontList_s4p_Word
'     and runs it
's4p 260301...10
'modify, comment, uncomment what you want</span>

   <span class=3D"cmt">'                CLICK HERE
   '                Press F5 to Run!
   ' CALLs
   '  FontList_s4p_Word</span>
  =20
   <span class=3D"kw">Dim</span> bSort <span class=3D"kw">As Boolean</span>=
  <span class=3D"cmt">'sort font list by name when done</span>
   <span class=3D"kw">Dim</span> bWatch <span class=3D"kw">As Boolean</span=
>  <span class=3D"cmt">'watch as Word document is written to</span>
   <span class=3D"kw">Dim</span> nEndExample <span class=3D"kw">As Long</sp=
an>  <span class=3D"cmt">'end point for characters to show if &gt;2 and &gt=
;=3D32</span>
   <span class=3D"kw">Dim</span> sFontname <span class=3D"kw">As String</sp=
an>  <span class=3D"cmt">'limit output to only one font</span>
   <span class=3D"kw">Dim</span> sFontlist <span class=3D"kw">As String</sp=
an>  <span class=3D"cmt">'limit output to a list of fonts</span>
   <span class=3D"kw">Dim</span> sWildPattern <span class=3D"kw">As String<=
/span>  <span class=3D"cmt">'wildcard pattern for font names</span>
   <span class=3D"kw">Dim</span> sDescriptionFont <span class=3D"kw">As Str=
ing</span>  <span class=3D"cmt">'text to include in filename</span>
  =20
   <span class=3D"kw">Dim</span> nStartExample <span class=3D"kw">As Long</=
span>  <span class=3D"cmt">'start point for Unicode characters to show.
   '  Under 32 not allowed, must be &gt;=3DnEndExample for Unicode</span>
  =20
   <span class=3D"kw">Dim</span> vFont <span class=3D"kw">As Variant</span>=
  <span class=3D"cmt">'for looping FontNames collection for sWildPattern</s=
pan>
  =20
   <span class=3D"cmt">'=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D
   '------------------------------------------- CUSTOMIZE
   '   if all parameters are commented will use defaults:
   '     show a sample of all installed fonts
   '     for common keyboard characters
   '-------------------------------------------
   ' use none or one value for each parameter
   '  examples are commented so you can turn them on and change if desired
   '-------------------------------------------
   '------------------------- bSort
'   bSort =3D False 'Default, don't sort, show as they are
'   bSort =3D True 'sort by font name when done
   '------------------------- bWatch
'   bWatch =3D False 'Default -- runs faster!
'   bWatch =3D True  'watch progress -- takes more time, can be more accura=
te
   '------------------------- nEndExample for a specific list OR AscW()
   'before ASCII 32 (space) are control characters
   '  so 32 is the first character allowed
   '-------------------------
'   nEndExample =3D 255</span>
  =20
   <span class=3D"cmt">'specific list -- uses ASCII, Chr()
'   nEndExample =3D 0 'Common keyboard characters, space between each set
'   nEndExample =3D 1 'ASCII from 32
'   nEndExample =3D 2 'ASCII+Extended ASCII, from 32 to 255</span>

   <span class=3D"cmt">'use Unicode, ChrW()
   '----  &gt;=3D32 is Last Unicode decimal character to show
'   nEndExample =3D 255 'correlate to Extended ASCII
'   nEndExample =3D 1000
   '-------------------------
   '------------------------- nStartExample for AscW()
   'if not defined, will be set to 32
'   nStartExample =3D 32 'or greater, must be less than nEndExample</span>
  =20
   <span class=3D"cmt">'-------------------------------------- Fonts
   '------------------------- sFontname
'   sFontname =3D "" 'Default all fonts
'   sFontname =3D "Calibri"
'   sFontname =3D "Aptos"
'   sFontname =3D "Lucida Sans Unicode"
'   sFontname =3D "Unicode MS"
'   sFontname =3D "Arial"
'   sFontname =3D "Times New Roman"
'   sFontname =3D "Tahoma"
'   sFontname =3D "Cambria Math"
'   sFontname =3D "Segoe UI Symbol"
   '------------------------- sFontlist
   '                          sDescriptionFont
   ' sDescriptionFont is text to include in filename
   'sFontlist =3D "" 'default if not specified: show all fonts
   'to limit fonts to a list:
   '  begin, end, and delimit with ~
   '  no extra spaces</span>
  =20
<span class=3D"cmt">'   sDescriptionFont =3D "Common_fonts"
'   sFontlist =3D "~" _
'      &amp; "Arial~Times New Roman~" _
'      &amp; "Courier New~" _
'      &amp; "Symbol~" _
'      &amp; "Aptos~Calibri~" _
'      &amp; "Broadway~Comic Sans MS~" _
'      &amp; "Brush Script MT~Wingdings~"</span>

   <span class=3D"cmt">' fair Unicode coverage
'   sDescriptionFont =3D "Unicode_fonts"
'   sFontlist =3D "~Lucida Sans Unicode~" _
'      &amp; "Times New Roman~Arial~"</span>

   <span class=3D"cmt">' symbols
'   sDescriptionFont =3D "Symbols"
'   sFontlist =3D "~Wingdings~Wingdings 2~" _
'      &amp; "Wingdings 3~Webdings~Convection Symbol~" _
'      &amp; "MS Outlook~MS Reference Specialty~" _
'      &amp; "MT Extra~"
   '------------------------- sWildPattern
   '                          sDescriptionFont
   ' instead of listing fonts yourself,
   '     have VBA make a list of typefaces for sFontlist
   '     that match a pattern.
   '     This takes priority if set.
'   sWildPattern =3D "" 'default if not specified
'   sDescriptionFont =3D "Aptos_Family"
'   sWildPattern =3D "Aptos*"
'   sDescriptionFont =3D "Arial_Family"
'   sWildPattern =3D "Arial*"
'   sDescriptionFont =3D "Lucida_Family"
'   sWildPattern =3D "Lucida*"
'   sDescriptionFont =3D "Segoe_Family"
'   sWildPattern =3D "Segoe*"
'   sDescriptionFont =3D "Verdana_Family"
'   sWildPattern =3D "Verdana*"</span>

<span class=3D"cmt">'   sDescriptionFont =3D "Mono_fonts"
'   sWildPattern =3D "*Mono*"
'   sDescriptionFont =3D "Black_fonts"
'   sWildPattern =3D "*Black*"
'   sDescriptionFont =3D "Bold_fonts"
'   sWildPattern =3D "*Bold*"
'   sDescriptionFont =3D "Script_fonts"
'   sWildPattern =3D "*Script*"
'   sDescriptionFont =3D "Hand_fonts"
'   sWildPattern =3D "*Hand*"
'   sDescriptionFont =3D "dings_fonts"
'   sWildPattern =3D "*dings*"</span>
  =20
   <span class=3D"cmt">'------------------------------------------- example
   ' if choosing a lot of points, maybe limit to just one or a few fonts
   ' However, Word seems to use other fonts whenever it wants
   ' so the Font being listed may not be the font for all the characters
   ' points 8448-11903 include the following blocks:
   ' Letterlike Symbols, Number Forms, Arrows, Mathematical Operators
   ' , Miscellaneous Technical, Control Pictures, OCR, Enclosed Alphanumeri=
cs
   ' , Box Drawing, Block Elements, Geometric Shapes, Miscellaneous Symbols
   ' , Dingbats, Miscellaneous Mathematical Symbols, Supplemental Arrows
   ' , Braille Patterns, (Miscellaneous other stuff)
'   nStartExample =3D 8448
'   nEndExample =3D 11903
   '------------------------------------------- end customize</span>
  =20
   <span class=3D"cmt">'=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D</span=
>
  =20
   <span class=3D"cmt">'-------------------- if wildcard pattern was specif=
ied, build font list</span>
   <span class=3D"kw">If</span> sWildPattern &lt;&gt;  "" <span class=3D"kw=
">Then</span>=20
      sFontlist =3D  "" <span class=3D"cmt">'clear, this takes priority
      'build list of names that match pattern</span>
      <span class=3D"kw">For Each</span> vFont <span class=3D"kw">In</span>=
 FontNames=20
         <span class=3D"kw">If</span> vFont <span class=3D"kw">Like</span> =
sWildPattern <span class=3D"kw">Then</span>=20
            sFontlist =3D sFontlist &amp; vFont &amp;  "~"
         <span class=3D"kw">End If</span>=20
      <span class=3D"kw">Next</span> vFont=20
      <span class=3D"cmt">'if fonts were found, add beginning ~</span>
      <span class=3D"kw">If</span> sFontlist &lt;&gt;  "" <span class=3D"kw=
">Then</span>=20
         <span class=3D"cmt">'add ~ to beginning of list</span>
         sFontlist =3D  "~" &amp; sFontlist=20
         <span class=3D"cmt">'clear specific font name if set</span>
         sFontname =3D  ""
      <span class=3D"kw">Else</span>=20
         MsgBox  "No font names match wildcard pattern:" _=20
            &amp; vbCrLf &amp; sWildPattern _=20
            &amp; vbCrLf &amp;  "Change variables and try again" _=20
            ,, "No font names in specified list"
         <span class=3D"kw">Exit Sub</span>=20
      <span class=3D"kw">End If</span>=20
   <span class=3D"kw">End If</span>=20
   <span class=3D"cmt">'--------------------</span>
  =20
   <span class=3D"cmt">'=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D</span=
>
  =20
   <span class=3D"cmt">'-------------------- Call FontList_s4p_Word</span>
   <span class=3D"kw">Call</span> FontList_s4p_Word( _=20
      nEndExample,bSort,bWatch _=20
      ,sFontname,sFontlist _=20
      ,sDescriptionFont,nStartExample)=20

<span class=3D"kw">End Sub</span>=20

<span class=3D"cmt">'------------------------------------------------------=
-------------------------
'                       FontList_s4p_Word
'--------------------------------------------------------------------------=
-----</span>
<span class=3D"kw">Sub</span> FontList_s4p_Word( _=20
   <span class=3D"kw">Optional</span> pnEndExample <span class=3D"kw">As Lo=
ng</span> =3D 0 _=20
   ,<span class=3D"kw">Optional</span> pbSort <span class=3D"kw">As Boolean=
</span> _=20
   ,<span class=3D"kw">Optional</span> pbWatch <span class=3D"kw">As Boolea=
n</span> _=20
   ,<span class=3D"kw">Optional</span> psFontname <span class=3D"kw">As Str=
ing</span> _=20
   ,<span class=3D"kw">Optional</span> psFontlist <span class=3D"kw">As Str=
ing</span> _=20
   ,<span class=3D"kw">Optional</span> psDescriptionFont <span class=3D"kw"=
>As String</span> =3D  "" _=20
   ,<span class=3D"kw">Optional ByVal</span> pnStartExample <span class=3D"=
kw">As Long</span> =3D 0 _=20
   )=20
<span class=3D"cmt">'220420 strive4peace,2205,2602...260310
'make a new Word document showing installed fonts
'  and examples of their characters</span>

   <span class=3D"cmt">'CALLS
   '  Word_Margins_Narrow
   '  Styles_FontList_s4p
   '  Word_NewTable_s4p
   '  Word_TableBorders_s4p
   '  WriteHeader_s4p_FontList
   '  WordDocumentSaveClose</span>

   <span class=3D"cmt">'PARAMETERs
   '  pnEndExample determines how many example characters to show
   '        if not set, show short examples
   '        0 for short -- uppercase, lowercase, digits
   '        1 ASCII 32 to to 127
   '        2 Extended ASCII 32 to 255
   '        ---
   '        &gt;=3D32 is Last Unicode decimal value from 32
   '           if symbol is defined in 128-255,
   '           won't often be the same as Extended ASCII
   '
   '  pbSort is True to sort by font name when done
   '  pbWatch is True to watch as document is built
   '  psFontname is specified if output should just be for 1 font name
   '  psFontlist is specified as "~Font1~Font2~"
   '     beginning, ending, and delimited with ~
   '  psDescriptionFont for text to include in filename
   '  pnStartExample start Unicode at number. Set to 32 (space) if less</sp=
an>
  =20
   <span class=3D"cmt">'  LIMIT_dev: if &gt;0 then
   '     stop writing table after LIMIT_dev number of fonts
   '     BE CAREFUL IF YOU CHANGE THIS</span>
   <span class=3D"kw">Const</span> LIMIT_dev <span class=3D"kw">As Long</sp=
an> =3D 0  <span class=3D"cmt">'developer change if desired</span>

   <span class=3D"kw">On Error GoTo</span> Proc_Err=20

   <span class=3D"cmt">'early binding</span>
   <span class=3D"kw">Dim</span> oDoc <span class=3D"kw">As</span> Document=
=20
   <span class=3D"kw">Dim</span> oRange <span class=3D"kw">As</span> Range=
=20
   <span class=3D"kw">Dim</span> oTable <span class=3D"kw">As</span> Table=
=20
  =20
   <span class=3D"kw">Dim</span> sDocName <span class=3D"kw">As String</spa=
n> _=20
      ,sDescriptionExample <span class=3D"kw">As String</span> _=20
      ,sTextExample <span class=3D"kw">As String</span> _=20
      ,sMsg <span class=3D"kw">As String</span> _=20
      ,sMsgAttrib <span class=3D"kw">As String</span> _=20
      ,sNameRows <span class=3D"kw">As String</span> _=20
      ,sPathReturn <span class=3D"kw">As String</span> _=20
      ,sPathFile <span class=3D"kw">As String</span> _=20
      ,sgTimer <span class=3D"kw">As Single</span> _=20
      ,sChar <span class=3D"kw">As String</span>=20

   <span class=3D"kw">Dim</span> n <span class=3D"kw">As Long</span> _=20
      ,nRow <span class=3D"kw">As Long</span> _=20
      ,nFonts <span class=3D"kw">As Long</span> _=20
      ,nFontCount <span class=3D"kw">As Long</span> _=20
      ,nLen <span class=3D"kw">As Long</span>=20
     =20
   <span class=3D"kw">Dim</span> vsFontname <span class=3D"kw">As Variant</=
span>=20

   <span class=3D"kw">Dim</span> aHeadArray(1 <span class=3D"kw">To</span> =
2) <span class=3D"kw">As String</span>=20
  =20
   sgTimer =3D Timer=20
  =20
   <span class=3D"kw">If</span> pnStartExample &lt; 32 <span class=3D"kw">T=
hen</span>=20
      pnStartExample =3D 32=20
   <span class=3D"kw">End If</span>=20
  =20
   <span class=3D"kw">If</span> pnEndExample &gt; 2 <span class=3D"kw">Then=
</span>=20
      <span class=3D"kw">If</span> pnEndExample &lt; 32 <span class=3D"kw">=
Then</span>=20
         MsgBox  "Can't process " &amp; pnEndExample _=20
         &amp; vbCrLf &amp; vbCrLf _=20
         &amp;  "Last Unicode character must be at least 32 (space)" _=20
         ,, "Abort Get FontList"
         <span class=3D"kw">Exit Sub</span>=20
      <span class=3D"kw">ElseIf</span> pnEndExample &lt; pnStartExample <sp=
an class=3D"kw">Then</span>=20
         MsgBox  "End " &amp; pnEndExample _=20
         &amp;  " can't be less than Start " &amp; pnStartExample _=20
         ,, "Abort Get FontList"
         <span class=3D"kw">Exit Sub</span>=20
      <span class=3D"kw">End If</span>=20
   <span class=3D"kw">End If</span>=20
        =20
   <span class=3D"cmt">'count fonts</span>
   nFontCount =3D FontNames.Count=20

   <span class=3D"kw">If</span> psFontname &lt;&gt;  "" <span class=3D"kw">=
Then</span>=20
      nFonts =3D 1=20
      sNameRows =3D  ""
   <span class=3D"kw">ElseIf</span> psFontlist &lt;&gt;  "" <span class=3D"=
kw">Then</span>=20
      nFonts =3D <span class=3D"kw">UBound</span>(Split(psFontlist, "~")) -=
 1=20
      sNameRows =3D  "_" &amp; nFonts _=20
            &amp;  "of" &amp; nFontCount=20
   <span class=3D"kw">Else</span>=20
      <span class=3D"cmt">'rows part of filename</span>
      <span class=3D"kw">If</span> LIMIT_dev &gt; 0 <span class=3D"kw">And<=
/span> LIMIT_dev &lt; nFontCount <span class=3D"kw">Then</span>=20
         <span class=3D"cmt">'output limited by parameters</span>
         nFonts =3D LIMIT_dev=20
         sNameRows =3D  "_" &amp; nFonts _=20
            &amp;  "LimitOf" &amp; nFontCount=20
      <span class=3D"kw">Else</span>=20
         nFonts =3D nFontCount  <span class=3D"cmt">'default</span>
         sNameRows =3D  "_" &amp; nFonts=20
      <span class=3D"kw">End If</span>=20
   <span class=3D"kw">End If</span>=20
  =20
   <span class=3D"kw">If</span> nFonts =3D 0 <span class=3D"kw">Then</span>=
=20
      MsgBox  "Error, no fonts to display" _=20
         ,, "Check parameters"
      <span class=3D"kw">GoTo</span> Proc_Exit=20
   <span class=3D"kw">End If</span>=20

   <span class=3D"cmt">'---------------------------  example string</span>
   sTextExample =3D  ""
   sDescriptionExample =3D  ""
   <span class=3D"kw">If</span> pnEndExample =3D 0 <span class=3D"kw">Then<=
/span>  <span class=3D"cmt">'common keyboard characters</span>
  =20
      sTextExample =3D _=20
         "ABCDEFGHIJKLMNOPQRSTUVWXYZ " _=20
         &amp;  "abcdefghijklmnopqrstuvwxyz" _=20
         &amp; vbCrLf _=20
         &amp;  "0123456789 !@#$%^&amp;*() -_=3D+[{]}\|;:,./&lt;&gt;? "

   <span class=3D"kw">ElseIf</span> pnEndExample =3D 1 <span class=3D"kw">T=
hen</span>  <span class=3D"cmt">'ASCII</span>
      sDescriptionExample =3D  "_ASCII"
      <span class=3D"kw">For</span> n =3D 32 <span class=3D"kw">To</span> 1=
27  <span class=3D"cmt">'start, 32=3Dspace</span>
         sTextExample =3D sTextExample &amp; <span class=3D"kw">Chr</span>(=
n)=20
<span class=3D"cmt">'         'add space every 10 characters
'         If n Mod 10 =3D 0 Then
'            sTextExample =3D sTextExample &amp; " "
'         End If</span>
      <span class=3D"kw">Next</span> n=20
   <span class=3D"kw">ElseIf</span> pnEndExample =3D 2 <span class=3D"kw">T=
hen</span>  <span class=3D"cmt">'Extended ASCII</span>
      sDescriptionExample =3D  "_ExtendedASCII"
      <span class=3D"kw">For</span> n =3D 32 <span class=3D"kw">To</span> 2=
55  <span class=3D"cmt">'space to 255</span>
         <span class=3D"kw">If</span> n =3D 128 <span class=3D"kw">Then</sp=
an>=20
            sTextExample =3D sTextExample &amp; vbCrLf=20
         <span class=3D"kw">End If</span>=20
         sTextExample =3D sTextExample &amp; <span class=3D"kw">Chr</span>(=
n)=20
      <span class=3D"kw">Next</span> n=20

   <span class=3D"cmt">'Else</span>
     =20
   <span class=3D"kw">Else</span>  <span class=3D"cmt">'UNICODE
      '&gt;2</span>
      sDescriptionExample =3D  "_Unicode_" _=20
         &amp; Format(pnStartExample, "0") &amp;  "to" _=20
         &amp; Format(pnEndExample, "0")=20
      <span class=3D"kw">For</span> n =3D pnStartExample <span class=3D"kw"=
>To</span> pnEndExample=20
         sChar =3D ChrW(n)=20
         <span class=3D"cmt">'add paragraph before each multiple of 128</sp=
an>
         <span class=3D"kw">If</span> n <span class=3D"kw">Mod</span> 128 =
=3D 0 <span class=3D"kw">And</span> n &lt;&gt; pnStartExample <span class=
=3D"kw">Then</span>=20
            sTextExample =3D sTextExample &amp; vbCrLf=20
         <span class=3D"kw">End If</span>=20
         sTextExample =3D sTextExample &amp; sChar=20
      <span class=3D"kw">Next</span> n=20
   <span class=3D"kw">End If</span>  <span class=3D"cmt">'pnEndExample
   '---------------- END example string</span>
  =20
   <span class=3D"cmt">'--------------------------- Document Name</span>
   sDocName =3D  "FontList" _=20
      &amp; sDescriptionExample _=20
      &amp; IIf(psDescriptionFont &lt;&gt;  "" _=20
         , "_" &amp; psDescriptionFont _=20
         ,vbNullString) _=20
      &amp; sNameRows _=20
      &amp; IIf(psFontname &lt;&gt;  "" _=20
         , "_" &amp; psFontname _=20
      ,IIf(pbSort, "_sort", ""))=20

<span class=3D"kw">Debug.Print</span>=20
<span class=3D"kw">Debug.Print</span>  "------- " &amp; Now() &amp; vbCrLf =
&amp; sDocName=20

   <span class=3D"cmt">'--------------------------- new Word document
   'make new Word document</span>
   <span class=3D"kw">Set</span> oDoc =3D Documents.Add=20
  =20
   <span class=3D"cmt">'turn off screen updating</span>
   <span class=3D"kw">If</span> pbWatch =3D <span class=3D"kw">False Then</=
span>=20
      Application.ScreenUpdating =3D <span class=3D"kw">False</span>=20
   <span class=3D"kw">End If</span>=20
  =20
   <span class=3D"cmt">'turn on Status Bar</span>
   Application.DisplayStatusBar =3D <span class=3D"kw">True</span>=20
   Application.StatusBar =3D  "Creating document with list of font names"
  =20
   <span class=3D"cmt">'set narrow page margins</span>
   <span class=3D"kw">Call</span> Word_Margins_Narrow(oDoc)=20

   <span class=3D"cmt">'attribution</span>
   sMsgAttrib =3D  "This document was created by VBA code " _=20
         &amp;  " written by crystal  (strive4peace)  msaccessgurus.com  "
  =20
   <span class=3D"kw">With</span> oDoc.Range=20
  =20
      <span class=3D"cmt">'-------------------------- info to describe docu=
ment</span>
      .InsertAfter sDocName=20
      .InsertParagraphAfter=20
      .Paragraphs(.Paragraphs.Count - 1).Style =3D  "Heading 1"
           =20
      .InsertAfter sMsgAttrib=20
      .InsertParagraphAfter=20

      .InsertAfter  "Download and information: "
<span class=3D"cmt">'      .InsertParagraphAfter</span>
     =20
      .Collapse 0=20
     =20
      <span class=3D"kw">Set</span> oRange =3D oDoc.Range=20
      oRange.Collapse 0=20
      .Hyperlinks.Add Anchor:=3DoRange _=20
      ,Address:=3D "https://msaccessgurus.com/tool/Word_FontList.htm " _=20
      ,TextToDisplay:=3D "https://msaccessgurus.com/tool/Word_FontList.htm =
"
  =20
   <span class=3D"cmt">'260302
   'duct tape</span>

      .Collapse 0=20
      .InsertParagraphAfter  <span class=3D"cmt">'didn't seem to get this, =
uncomment Collapse after</span>
      .Collapse 0=20
   <span class=3D"kw">End With</span>=20
  =20
   <span class=3D"kw">Set</span> oRange =3D oDoc.Range=20
   <span class=3D"kw">With</span> oRange=20
      .InsertParagraphAfter=20
      .InsertAfter Format(nFonts, "#,###") &amp;  " font" _=20
         &amp; IIf(nFonts &lt;&gt; 1, "s", "") &amp;  " listed"
      <span class=3D"kw">If</span> pbSort <span class=3D"kw">And</span> nFo=
nts &lt;&gt; 1 <span class=3D"kw">Then</span>=20
         .InsertAfter  ", sorted by Font Name"
      <span class=3D"kw">End If</span>=20
      .InsertParagraphAfter=20
   <span class=3D"kw">End With</span>  <span class=3D"cmt">'oRange</span>

   <span class=3D"cmt">'  Call Styles_FontList_s4p</span>
   <span class=3D"kw">Call</span> Styles_FontList_s4p(oDoc)=20
           =20
   <span class=3D"cmt">'set range to end of document</span>
   <span class=3D"kw">Set</span> oRange =3D oDoc.Content=20
   oRange.Collapse (0)  <span class=3D"cmt">'0=3DwdCollapseEnd</span>
     =20
   <span class=3D"cmt">'-------------------------- Table</span>

   <span class=3D"cmt">'make Word table at end of document with
   '  1 row for each font + row for heading
   '  2 columns
   '  skip Caption
   '  Column 1 Head =3D Font Name
   '  Column 2 Head =3D Example</span>
   <span class=3D"kw">If</span> psFontname &lt;&gt;  "" <span class=3D"kw">=
Then</span>=20
      aHeadArray(1) =3D psFontname &amp;  " Font"
   <span class=3D"kw">Else</span>=20
      aHeadArray(1) =3D  "Font Name"
   <span class=3D"kw">End If</span>=20
  =20
   aHeadArray(2) =3D  "Example"
  =20
   <span class=3D"cmt">'------------- CALL Word_NewTable_s4p</span>
   Application.StatusBar =3D  "list font names ... table and borders"
   <span class=3D"kw">Set</span> oTable =3D Word_NewTable_s4p( _=20
      oDoc,oRange _=20
      ,nFonts + 1 _=20
      ,2 _=20
      ,aHeadArray)=20

   <span class=3D"kw">Call</span> Word_TableBorders_s4p(oTable)=20

   <span class=3D"kw">With</span> oTable=20
      <span class=3D"cmt">'style Column 1 for Heading 3
      'use selection to do them all</span>
      Application.StatusBar =3D  "list font names ... style"
      .Columns(1).Select=20
      Selection.Style =3D ActiveDocument.Styles( "Heading 3")=20
      .Cell(1,1).Range.Style =3D  "Normal"
     =20
      <span class=3D"cmt">'style Column 2
      'hanging 1st line to see where blocks start</span>
      .Columns(2).Select=20
      <span class=3D"kw">With</span> .Range.ParagraphFormat=20
         .LeftIndent =3D 6  <span class=3D"cmt">'~0.1 * 72 'InchesToPoints<=
/span>
         .FirstLineIndent =3D -6=20
      <span class=3D"kw">End With</span>=20
      <span class=3D"kw">With</span> .Cell(1,2).Range.ParagraphFormat=20
         .LeftIndent =3D 0=20
         .FirstLineIndent =3D 0=20
      <span class=3D"kw">End With</span>=20
   <span class=3D"kw">End With</span>=20
  =20
   <span class=3D"kw">With</span> oTable=20
      <span class=3D"cmt">'1. FontName, 2. Example
      '----------------------- Column widths</span>
      .Columns(1).PreferredWidth =3D <span class=3D"kw">CInt</span>(1.8 * 7=
2)=20
      .Columns(2).PreferredWidth =3D <span class=3D"kw">CInt</span>(5.7 * 7=
2)=20
   <span class=3D"kw">End With</span>=20

   nRow =3D 1  <span class=3D"cmt">'allow for heading row</span>

   <span class=3D"kw">With</span> oTable=20
      <span class=3D"cmt">'loop through all the fonts</span>
      <span class=3D"kw">For Each</span> vsFontname <span class=3D"kw">In</=
span> FontNames=20
         <span class=3D"kw">If</span> psFontname &lt;&gt;  "" <span class=
=3D"kw">Then</span>=20
            <span class=3D"cmt">'Limit to only one font
            'redefine whatever found to use same code</span>
            vsFontname =3D psFontname=20
         <span class=3D"kw">ElseIf</span> psFontlist &lt;&gt;  "" <span cla=
ss=3D"kw">Then</span>=20
            <span class=3D"cmt">'if font not in list then loop to next</spa=
n>
            <span class=3D"kw">If</span> InStr(psFontlist _=20
               , "~" &amp; vsFontname &amp;  "~") =3D 0 <span class=3D"kw">=
Then</span>=20
               <span class=3D"kw">GoTo</span> proc_NextFont=20
            <span class=3D"kw">End If</span>=20
         <span class=3D"kw">End If</span>=20
        =20
<span class=3D"cmt">'developer</span>
<span class=3D"kw">If</span> LIMIT_dev &gt; 1 <span class=3D"kw">And</span>=
 nRow &gt; nFonts + 1 <span class=3D"kw">Then GoTo</span> proc_DoneList=20
           =20
         <span class=3D"cmt">'increment row</span>
         nRow =3D nRow + 1=20
         Application.StatusBar =3D  "list font names ..." _=20
           &amp; Format(nRow - 1, "#,##0") _=20
           &amp;  " of " &amp; Format(nFonts, "#,##0") _=20
           &amp;  " " &amp; vsFontname=20
           =20
         <span class=3D"cmt">'------------ write cells</span>
         <span class=3D"kw">With</span> .Cell(nRow,1)=20
            <span class=3D"kw">With</span> .Range=20
               nLen =3D <span class=3D"kw">Len</span>(vsFontname)=20
               .Text =3D vsFontname  <span class=3D"cmt">'&amp; vbCrLf does=
n't make it show in NavPane</span>
            <span class=3D"kw">End With</span>=20
         <span class=3D"kw">End With</span>=20

         <span class=3D"kw">With</span> .Cell(nRow,2).Range=20
            .Text =3D sTextExample=20
            <span class=3D"kw">If</span> pbWatch &lt;&gt; <span class=3D"kw=
">False Then</span>=20
               <span class=3D"cmt">'takes longer to watch but more interest=
ing
               'also more accurate for changing font for long examples</spa=
n>
               .Select=20
            <span class=3D"kw">End If</span>=20
            .Font.Name =3D vsFontname=20
         <span class=3D"kw">End With</span>=20
        =20
proc_NextFont:=20
         <span class=3D"kw">If</span> psFontname &lt;&gt;  "" <span class=
=3D"kw">Then</span>=20
            <span class=3D"cmt">'if just one font, stop</span>
            <span class=3D"kw">GoTo</span> proc_DoneList=20
         <span class=3D"kw">End If</span>=20
        =20
      <span class=3D"kw">Next</span> vsFontname=20
     =20
proc_DoneList:=20
      <span class=3D"cmt">'------------------------ sort</span>
      <span class=3D"kw">If</span> pbSort <span class=3D"kw">And</span> nFo=
nts &lt;&gt; 1 <span class=3D"kw">Then</span>=20
         Application.StatusBar =3D  "list font names ... sorting"
         .Sort ExcludeHeader:=3DTrue _=20
         ,FieldNumber:=3D1=20
      <span class=3D"kw">End If</span>=20
     =20
<span class=3D"kw">DoEvents</span>=20

   <span class=3D"kw">End With</span>  <span class=3D"cmt">'oTable</span>
     =20
   <span class=3D"cmt">' page header with Heading 1, Heading 3, page, numpa=
ges</span>
   Application.StatusBar =3D  "list font names ... header"
   <span class=3D"kw">Call</span> WriteHeader_s4p_FontList(oDoc)=20

   <span class=3D"cmt">'goto the first page
   '1=3DwdGoToPage
   '-1=3DwdGoToLast
   '1=3DwdGoToFirst
'   With oDoc
'      .GoTo 1, 1
'   End With</span>

Document_Save:=20
   Application.StatusBar =3D  "list font names ... SAVE file " &amp; sDocNa=
me=20
   sPathFile =3D WordDocumentSaveClose(oDoc,sDocName _=20
      , "strive4peace",,sPathReturn)=20
  =20
   <span class=3D"cmt">'calculate how much time this process took</span>
   sgTimer =3D Timer - sgTimer=20
  =20
   sMsg =3D Format(sgTimer, "#,###.#") &amp;  " seconds"
   <span class=3D"kw">If</span> sgTimer &gt; 60 <span class=3D"kw">Then</sp=
an>=20
      sMsg =3D sMsg &amp;  " =E2=80=94 " _=20
         &amp; sgTimer \ 60 &amp;  " minute" _=20
            &amp; IIf(sgTimer &gt;=3D 120, "s",<span class=3D"kw">Null</spa=
n>) _=20
            &amp;  ", " _=20
         &amp; Format(sgTimer - (sgTimer \ 60) * 60, "#.#") _=20
         &amp;  " seconds"
   <span class=3D"kw">End If</span>=20
  =20
   <span class=3D"cmt">'--------------------------- message</span>
   sMsg =3D Now() &amp;  " done " _=20
      &amp; IIf(pbWatch,vbCrLf &amp;  ", watch ",<span class=3D"kw">Null</s=
pan>) _=20
      &amp; vbCrLf &amp; sMsg=20
     =20
   <span class=3D"kw">Debug.Print</span> sMsg=20

   sMsg =3D  "Font list document has been created." _=20
      &amp; vbCrLf &amp; sPathFile _=20
      &amp; vbCrLf &amp; vbCrLf &amp; sMsg &amp;  " to execute" _=20
      &amp; vbCrLf &amp; vbCrLf &amp;  "Open the path?"
     =20
   <span class=3D"kw">If</span> MsgBox(sMsg,vbYesNo, "Done") =3D vbYes <spa=
n class=3D"kw">Then</span>=20
      <span class=3D"kw">Call</span> Shell( "Explorer.exe" &amp;  " " &amp;=
 sPathReturn,vbNormalFocus)=20
   <span class=3D"kw">End If</span>=20
  =20
Proc_Exit:=20
   <span class=3D"kw">Set</span> oRange =3D <span class=3D"kw">Nothing</spa=
n>=20
   <span class=3D"kw">Set</span> oTable =3D <span class=3D"kw">Nothing</spa=
n>=20
   <span class=3D"kw">Set</span> oDoc =3D <span class=3D"kw">Nothing</span>=
=20
   Application.StatusBar =3D  ""
   Application.ScreenUpdating =3D <span class=3D"kw">True</span>=20
   <span class=3D"kw">Exit Sub</span>=20
 =20
Proc_Err:=20
   MsgBox Err.Description _=20
       ,, "ERROR " &amp; Err.Number _=20
        &amp;  "   FontList_s4p_Word"

   <span class=3D"kw">Resume</span> Proc_Exit=20
   <span class=3D"kw">Resume</span>=20
<span class=3D"kw">End Sub</span>=20

