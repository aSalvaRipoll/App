'~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~</span>
<span class=3D"kw">Public Sub</span> WhatIsSelectedCharacter()=20
<span class=3D"cmt">'260303-10 s4p
' Because this runs on what is rendered,
' it's not actual source number to create character
' and may not be right</span>
     =20
   <span class=3D"cmt">'  1. select something in a Word document
   '  2. CLICK HERE
   '  3. Press F5 to Run!</span>
  =20
   <span class=3D"cmt">'future: may need to set to a richer Unicode font</s=
pan>
   <span class=3D"kw">Const</span> sFONTNAMEinfo =3D  "Arial"
  =20
   <span class=3D"kw">Dim</span> sChar <span class=3D"kw">As String</span>=
=20
   <span class=3D"kw">Dim</span> sMsg <span class=3D"kw">As String</span>=
=20
  =20
   <span class=3D"kw">Dim</span> nASCII <span class=3D"kw">As Long</span>=
=20
   <span class=3D"kw">Dim</span> nAscW <span class=3D"kw">As Long</span>=20
   <span class=3D"kw">Dim</span> nLen <span class=3D"kw">As Long</span>=20
  =20
   <span class=3D"kw">Dim</span> sFont <span class=3D"kw">As String</span>=
=20
     =20
   <span class=3D"kw">With</span> Selection.Range  <span class=3D"cmt">'oRa=
nge</span>
      nLen =3D .Characters.Count=20
      <span class=3D"kw">If</span> nLen &gt; 1 <span class=3D"kw">Then</spa=
n>=20
         sMsg =3D  "the first character of the "
         .SetRange .Start,.Start + 1  <span class=3D"cmt">'reduce to 1 char=
acter</span>
      <span class=3D"kw">End If</span>=20
      <span class=3D"cmt">'sometimes Word makes font substitutions as it wa=
nts to display characters</span>
      sFont =3D .Font.Name=20
  =20
      sChar =3D .Text=20
      <span class=3D"kw">If</span> sChar =3D  "" <span class=3D"kw">Then</s=
pan>=20
         MsgBox  "nothing selected",, "No character info"
         <span class=3D"kw">Exit Sub</span>=20
      <span class=3D"kw">End If</span>=20
     =20
      nAscW =3D AscW(sChar)=20
      nASCII =3D Asc(sChar)=20
     =20
      <span class=3D"kw">If</span> nAscW &lt; 0 <span class=3D"kw">Then</sp=
an>=20
         <span class=3D"cmt">'minimize problem with symbol fonts</span>
         .Font.Name =3D sFONTNAMEinfo=20
         sChar =3D .Text=20
         nAscW =3D AscW(sChar)=20
         .Document.Undo=20
      <span class=3D"kw">End If</span>=20
   <span class=3D"kw">End With</span>=20

   sMsg =3D  "Info about " &amp; sMsg &amp;  "selection" _=20
      &amp; vbCrLf &amp; vbCrLf &amp; Space(5) &amp; sChar _=20
      &amp; Space(5) &amp;  "in document as " &amp; sFont _=20
      &amp; vbCrLf=20

   <span class=3D"kw">If</span> sChar =3D <span class=3D"kw">Chr</span>(nAS=
CII) _=20
   <span class=3D"kw">Then</span>=20
      sMsg =3D sMsg &amp; vbCrLf _=20
         &amp;  "Asc =3D " &amp; nASCII=20
   <span class=3D"kw">End If</span>=20

<span class=3D"cmt">'   If sChar =3D ChrW(nAscW) Then</span>
      sMsg =3D sMsg &amp; vbCrLf _=20
         &amp;  "AscW =3D " &amp; nAscW=20
<span class=3D"cmt">'   End If</span>
     =20
   sMsg =3D sMsg &amp; vbCrLf &amp; vbCrLf _=20
      &amp;  "Press Ctrl-C to copy message" _=20
      &amp;  " then paste wherever you want"
  =20
   <span class=3D"kw">Call</span> Unicode_MsgBox(sMsg,vbOKOnly _=20
      , "What is Selected Character?")=20
  =20
<span class=3D"kw">End Sub</span>=20

