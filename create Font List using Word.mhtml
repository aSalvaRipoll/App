<span class=3D"kw">Public Function</span> Word_NewTable_s4p(oDoc <span clas=
s=3D"kw">As</span> Document _=20
   ,oRange <span class=3D"kw">As</span> Range _=20
   ,<span class=3D"kw">ByVal</span> pnRows <span class=3D"kw">As Long</span=
> _=20
   ,<span class=3D"kw">ByVal</span> pnCols <span class=3D"kw">As Long</span=
> _=20
   ,pasHeadArray() <span class=3D"kw">As String</span> _=20
   ) <span class=3D"kw">As</span> Table=20
<span class=3D"cmt">'strive4peace 170811,20202,04,2303,06,260305,10</span>

   <span class=3D"kw">Dim</span> i <span class=3D"kw">As Integer</span>=20
  =20
   <span class=3D"cmt">'insert table</span>
   <span class=3D"kw">With</span> oDoc=20
      <span class=3D"kw">Set</span> Word_NewTable_s4p =3D .Tables.Add( _=20
         Range:=3DoRange _=20
         ,NumRows:=3DpnRows _=20
         ,NumColumns:=3DpnCols _=20
         )=20

   <span class=3D"kw">End With</span>=20
     =20
   <span class=3D"kw">With</span> Word_NewTable_s4p=20
      <span class=3D"cmt">'Position - wdCaptionPositionAbove=3D0
'      .ApplyStyleHeadingRows =3D True</span>
      .TopPadding =3D 0=20
      .BottomPadding =3D 0=20
      .LeftPadding =3D 2  <span class=3D"cmt">'points</span>
      .RightPadding =3D 2=20
      .Spacing =3D 0  <span class=3D"cmt">'Auto</span>
      .AllowPageBreaks =3D <span class=3D"kw">True</span>=20
      .AllowAutoFit =3D <span class=3D"kw">False</span>=20
 =20
      <span class=3D"cmt">'mark heading row</span>
      .Rows(1).HeadingFormat =3D <span class=3D"kw">True</span>=20
      <span class=3D"cmt">'allow rows to break so long cells don't add extr=
a pages</span>
      .Rows.AllowBreakAcrossPages =3D <span class=3D"kw">True</span>=20
=20
      <span class=3D"cmt">'no space above text between paragraphs</span>
      .Range.Paragraphs.SpaceBefore =3D 0=20
=20
      <span class=3D"cmt">'1 wdCellAlignVerticalCenter
      '0 wdCellAlignVerticalTop</span>
      .Range.Cells.VerticalAlignment =3D 0=20
=20
      <span class=3D"cmt">'Heading Row 1</span>
      <span class=3D"kw">For</span> i =3D <span class=3D"kw">LBound</span>(=
pasHeadArray) <span class=3D"kw">To UBound</span>(pasHeadArray)=20
         .Cell(1,i).Range.Text =3D pasHeadArray(i)=20
      <span class=3D"kw">Next</span> i=20
     =20
=20
   <span class=3D"kw">End With</span>=20
=20
<span class=3D"kw">End Function</span>=20

<span class=3D"cmt">'~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
'           Word_TableBorders_s4p
