_=20
    ,<span class=3D"kw">ByVal</span> lpText <span class=3D"kw">As Long</spa=
n> _=20
    ,<span class=3D"kw">ByVal</span> lpCaption <span class=3D"kw">As Long</=
span> _=20
    ,<span class=3D"kw">ByVal</span> uType <span class=3D"kw">As Long</span=
> _=20
    ) <span class=3D"kw">As Long</span>=20
#End <span class=3D"kw">If</span>=20
<span class=3D"cmt">'~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
